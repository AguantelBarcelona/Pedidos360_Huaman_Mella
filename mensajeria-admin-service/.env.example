# mensajeria-admin-service - copiar a .env (NO subir .env a Git)
SERVER_PORT=8086

# Cognito (las mismas que pedidos-service). Toda la API exige grupo ADMIN.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

AWS_REGION=us-east-1
# Solo se administran recursos cuyo nombre empieza con este prefijo
MENSAJERIA_PREFIJO=pedidos360
# Purga de DLQ (destructiva). Poner false para deshabilitarla.
PERMITIR_PURGA_DLQ=true
# Instancias de consumidores-service para pausar/reanudar (separadas por coma)
CONSUMIDORES_URLS=http://localhost:8084,http://localhost:8085
