# consumidores-service - copiar a .env (NO subir .env a Git)
SERVER_PORT=8084
INSTANCIA_ID=consumidores-a

# RDS PostgreSQL (las mismas que pedidos-service; el esquema "mensajeria" se crea solo)
DB_HOST=tu-rds.xxxxxx.us-east-1.rds.amazonaws.com
DB_NAME=postgres
DB_USER=postgres
DB_PASS=cambiar

# Cognito (las mismas que pedidos-service)
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# SQS (valores en Outputs del stack pedidos360-ep2-mensajeria)
CONSUMIDORES_ENABLED=true
AWS_REGION=us-east-1
CONSUMIDORES_ACTIVOS=notificaciones,documentos,auditoria
SQS_NOTIFICACIONES_URL=https://sqs.us-east-1.amazonaws.com/CUENTA/pedidos360-notificaciones
SQS_NOTIFICACIONES_DLQ_URL=https://sqs.us-east-1.amazonaws.com/CUENTA/pedidos360-notificaciones-dlq
SQS_DOCUMENTOS_URL=https://sqs.us-east-1.amazonaws.com/CUENTA/pedidos360-documentos
SQS_DOCUMENTOS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/CUENTA/pedidos360-documentos-dlq
SQS_AUDITORIA_URL=https://sqs.us-east-1.amazonaws.com/CUENTA/pedidos360-auditoria
SQS_AUDITORIA_DLQ_URL=https://sqs.us-east-1.amazonaws.com/CUENTA/pedidos360-auditoria-dlq

# Opcionales
SQS_MAX_MENSAJES=5
SQS_ESPERA_SEGUNDOS=20
SQS_BACKOFF_BASE_SEGUNDOS=10
SQS_MAX_INTENTOS=3
